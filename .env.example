# Database
DATABASE_URL=postgresql://journalai:journalai_dev_password@localhost:5432/journalai

# MinIO / S3-compatible storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_password
MINIO_BUCKET_NAME=journal-entries
MINIO_REGION=us-east-1

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-at-least-32-chars
JWT_ISSUER=journal-ai
JWT_AUDIENCE=journal-ai-client
JWT_EXPIRATION_MINUTES=1440

# CORS & Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ASPNETCORE_ENVIRONMENT=Development

# Email (for export notifications, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=noreply@journalai.com

# Logging
LOG_LEVEL=Information
LOG_FILE_PATH=./logs

# Feature Flags
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_MINDMAP_GENERATION=true
ENABLE_ASYNC_EXPORTS=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_SECOND=10

# Data Retention (days)
DATA_RETENTION_DAYS=3650

# API
API_PORT=5000
API_VERSION=v1

# Frontend
VITE_API_URL=http://localhost:5000/api/v1
VITE_ENVIRONMENT=development
